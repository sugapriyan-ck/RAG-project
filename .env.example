# Supabase — Project Settings > API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key (sb_secret_...). SERVER-ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sarvam AI (optional server-side STT/TTS adapters). SERVER-ONLY.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=simran_en_customer

# OpenRouter — server-only. Embeddings + RAG answer generation.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
LLM_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PROVIDER_SORT=throughput
EMBEDDING_CACHE_TTL_MS=300000
EMBEDDING_CACHE_MAX_ENTRIES=256
